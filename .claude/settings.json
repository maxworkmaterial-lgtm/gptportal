{
  "enabledPlugins": {
    "text-to-cad@earthtojake": true,
    "rea@rea": true,
    "pixijs-skills@pixijs-skills": true,
    "gsap-skills@gsap-skills": true,
    "rigc@rigc": true
  },
  "extraKnownMarketplaces": {
    "earthtojake": {
      "source": {
        "source": "github",
        "repo": "earthtojake/text-to-cad",
        "ref": "latest"
      }
    },
    "rea": {
      "source": {
        "source": "github",
        "repo": "morluto/rea"
      }
    },
    "pixijs-skills": {
      "source": {
        "source": "github",
        "repo": "pixijs/pixijs-skills"
      }
    },
    "gsap-skills": {
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills"
      }
    },
    "rigc": {
      "source": {
        "source": "github",
        "repo": "rig-c/core"
      }
    }
  },
  "env": {
    "NODE_USE_ENV_PROXY": "1",
    "PHASER_AE_BROWSER_WEBGPU": "off"
  }
}
