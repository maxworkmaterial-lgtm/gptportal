{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(npx -y @phaser-ae/cli *)",
      "PowerShell(npx -y @phaser-ae/cli *)",
      "Bash(phaser-ae *)",
      "PowerShell(phaser-ae *)"
    ]
  },
  "env": {
    "PHASER_AE_BROWSER_WEBGPU": "off"
  }
}
